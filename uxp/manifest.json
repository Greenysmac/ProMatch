{
  "id": "com.promatch.panel.uxp",
  "name": "ProMatch",
  "version": "0.3.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "webview": {
      "allow": "yes",
      "allowLocalRendering": "yes",
      "domains": "all",
      "enableMessageBridge": "localAndRemote"
    }
  },
  "entrypoints": [
    {
      "id": "promatch",
      "type": "panel",
      "label": {
        "default": "ProMatch"
      },
      "minimumSize": {
        "width": 360,
        "height": 480
      },
      "maximumSize": {
        "width": 4000,
        "height": 4000
      },
      "preferredDockedSize": {
        "width": 520,
        "height": 900
      },
      "preferredFloatingSize": {
        "width": 520,
        "height": 900
      }
    }
  ]
}
